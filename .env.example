# Copy to .env.local (never commit it). Values from Supabase → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# App: anon (public) key. Every query runs as the signed-in user under RLS.
SUPABASE_ANON_KEY=
# Seed script only (npm run seed). Bypasses RLS — never used by the app.
SUPABASE_SERVICE_ROLE_KEY=
